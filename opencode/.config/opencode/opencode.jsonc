{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py"],
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py"],
    },
    "terraform": {
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"],
    },
  },
  "formatter": {},
  "permission": {
    "external_directory": {
      "~/.**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.docker/**": "deny",
      "~/.npmrc": "deny",
      "~/.yarnrc": "deny",
      "~/.pnpmrc": "deny",
      "~/.netrc": "deny",
      "**/.env*": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.crt": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "*": "allow",
    },
    "bash": {
      // === DENY: destructive commands ===
      "rm": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "git rm *": "deny",
      "git clean *": "deny",
      "kubectl delete *": "deny",
      "terraform destroy": "deny",
      "terraform destroy *": "deny",
      "docker rm *": "deny",
      "docker rmi *": "deny",
      // === ALLOW: git ===
      "git": "allow",
      "git *": "allow",
      // === ALLOW: read-only filesystem ===
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "head *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      // === ALLOW: modern alternatives ===
      "rg *": "allow",
      "fd *": "allow",
      // === ALLOW: GitHub CLI ===
      "gh *": "allow",
      // === ALLOW: package managers ===
      "npm run *": "allow",
      "npm test": "allow",
      "pnpm *": "allow",
      "bun run *": "allow",
      "bun test": "allow",
      // === ALLOW: infrastructure read-only ===
      "terraform plan": "allow",
      "terraform validate": "allow",
      "terraform fmt": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      // === catch-all ===
      "*": "ask",
    },
    "edit": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "question": "allow",
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
    "deep-wiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
    },
    "aws-knowledge": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws",
    },
    "microsoft-docs": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
    },
    "kubernetes": {
      "type": "local",
      "command": ["kubernetes-mcp-server", "--read-only"],
    },
    "mempalace": {
      "type": "local",
      "command": ["mempalace-mcp"],
    },
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
  ],
}
